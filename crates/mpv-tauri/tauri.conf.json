{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "mpv-tauri",
  "version": "0.1.0",
  "identifier": "com.mpv-tauri.app",
  "build": {
    "frontendDist": "dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Play with MPV",
        "width": 420,
        "height": 680,
        "resizable": true,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "icon": []
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "mpv",
          "cmd": "mpv",
          "args": true
        },
        {
          "name": "iina",
          "cmd": "open",
          "args": true
        }
      ]
    }
  }
}
